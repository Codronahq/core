{
  "name": "codrona",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": ">=3.3.18 <4"
    }
  },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "attribution:generate": "node scripts/generate-attribution.mjs",
    "attribution:check": "node scripts/generate-attribution.mjs && git diff --exit-code ATTRIBUTION.md"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.10.10",
    "typescript": "^5.5.0"
  }
}
